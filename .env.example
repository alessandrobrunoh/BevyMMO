# Local development defaults for the PostgreSQL Docker container.
# Copy this file to `.env` and adjust if needed. No real secrets here.

POSTGRES_USER=bevytest2
POSTGRES_PASSWORD=bevytest2_dev
POSTGRES_DB=bevytest2
POSTGRES_PORT=5432

# SeaORM connection string. Mirrors the values above.
DATABASE_URL=postgresql://bevytest2:bevytest2_dev@localhost:5432/bevytest2
